    "/admin/games/{id}/levels/{levelId}/apply": {
      "post": {
        "parameters": [
          {
            "type": "integer",
            "description": "ID игры",
            "name": "id",
            "in": "path",
            "required": true
          },
          {
            "type": "integer",
            "description": "ID уровня",
            "name": "levelId",
            "in": "path",
            "required": true
          },
          {
            "description": "Операции",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/models.AdminLevelApplyRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/models.AdminLevelApplyResponse"
            }
          },
          "207": {
            "description": "Часть операций не выполнена",
            "schema": {
              "$ref": "#/definitions/models.AdminLevelApplyResponse"
            }
          },
          "400": {
            "description": "Некорректный запрос",
            "schema": {
              "$ref": "#/definitions/models.ErrorResponse"
            }
          },
          "401": {
            "description": "Требуется авторизация",
            "schema": {
              "$ref": "#/definitions/models.ErrorResponse"
            }
          },
          "403": {
            "description": "Доступ запрещён",
            "schema": {
              "$ref": "#/definitions/models.ErrorResponse"
            }
          },
          "409": {
            "description": "stale_version | players_on_level",
            "schema": {
              "$ref": "#/definitions/models.AdminLevelApplyConflict"
            }
          }
        },
        "description": "Табличный редактор: create/update/delete по заданиям, подсказкам,\nштрафным подсказкам, бонусам, секторам и ответам одним запросом.\nНе более 200 операций. Если на уровне уже есть игроки, принимается\nтолько одна операция update; пока уровень пуст, массовые правки\nразрешены и в идущей игре. Устаревший base_version → 409 со свежим\nснимком."
      }
    }
  },
