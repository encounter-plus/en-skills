{
  "name": "@en-skills/encounter-agent-runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "encounter-agent": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
