{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "encounter-author": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/runtime/dist/server.mjs"
      ],
      "env": {
        "ENCOUNTER_DATA_DIR": "${PLUGIN_DATA}",
        "ENCOUNTER_WRITES_DISABLED": "1"
      },
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
